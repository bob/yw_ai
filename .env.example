OPENAI_API_KEY=your-openai-api-key
ASSISTANT_AGENT_MODEL=openai:gpt-4.1
ASSISTANT_PROMPT_CACHE_ENABLED=true
# Optional override; defaults to in_memory for gpt-4.1. Validate against the selected model.
# ASSISTANT_PROMPT_CACHE_RETENTION=in_memory
ASSISTANT_HISTORY_MAX_TOKENS=8192
ASSISTANT_HISTORY_TARGET_TOKENS=4096
ASSISTANT_HISTORY_SUMMARY_MAX_TOKENS=768
TYPESAFE_API_KEY=your-typesafe-api-key
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=langchain-app
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
ASANA_SERVICE_BASE_URL=http://0.0.0.0:4999
ASANA_CATALOG_FOLDER_UUID=yoga-public-v1
